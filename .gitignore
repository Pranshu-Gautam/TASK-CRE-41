.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.coverage
htmlcov/

# Secrets and local configuration — never commit these.
.env
.env.*
!.env.example

# Pipeline artefacts and caches are reproducible outputs, not source — but the
# directory itself is shipped. Docker bind-mounts it, and a missing host
# directory is created by the daemon as root, which the non-root container
# user then cannot write to.
data/*
!data/.gitkeep
