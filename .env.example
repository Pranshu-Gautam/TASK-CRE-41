# TASK-CRE-41 / Project IRIS Wave 4 — example environment file.
# Copy to .env and adjust. NEVER commit a real .env or production credentials.

# ---------------------------------------------------------------------------
# Database (local development only — these are throwaway local-only values)
# ---------------------------------------------------------------------------
# DB_URI is the single authoritative connection string used by the pipeline.
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
DB_URI=postgresql+psycopg://iris:iris_local_dev_only@localhost:55432/iris

# Values consumed by compose.yaml to initialise the local PostGIS container.
POSTGRES_USER=iris
POSTGRES_PASSWORD=iris_local_dev_only
POSTGRES_DB=iris
POSTGRES_HOST_PORT=55432

# ---------------------------------------------------------------------------
# Docker: run the pipeline container as your own user so the bind-mounted
# ./data and ./samples directories stay writable. Check with `id -u` / `id -g`.
# ---------------------------------------------------------------------------
APP_UID=1000
APP_GID=1000

# ---------------------------------------------------------------------------
# Schema isolation (hard requirement: candidate writes target staging only)
# ---------------------------------------------------------------------------
IRIS_STAGING_SCHEMA=iris_staging

# ---------------------------------------------------------------------------
# HTTP / scraping
# ---------------------------------------------------------------------------
# Identify yourself honestly: Nominatim and Overpass require an identifying
# User-Agent. VERIFIED 2026-10-31: nominatim.openstreetmap.org answers HTTP 403
# to library defaults (e.g. "python-requests/...") AND to placeholder contacts
# containing "example.org". Put a real contact address here before any large run.
IRIS_USER_AGENT=IRIS-Wave4-TASK-CRE-41/1.0 (Project IRIS Wave 4 technical assessment; contact via submission repository)
IRIS_HTTP_TIMEOUT=30
IRIS_HTTP_MAX_RETRIES=3
IRIS_SCRAPE_MIN_INTERVAL=1.0

# ---------------------------------------------------------------------------
# Geocoding (OSM Nominatim — https://operations.osmfoundation.org/policies/nominatim/)
# ---------------------------------------------------------------------------
IRIS_GEOCODER=nominatim
IRIS_NOMINATIM_URL=https://nominatim.openstreetmap.org/search
# Absolute hard floor of 1 request/second per the usage policy.
IRIS_NOMINATIM_MIN_INTERVAL=1.1
IRIS_GEOCODE_CACHE=data/geocode_cache.sqlite

# ---------------------------------------------------------------------------
# Geospatial enrichment (OSM Overpass API — ODbL 1.0, attribution required)
# ---------------------------------------------------------------------------
IRIS_OVERPASS_URL=https://overpass-api.de/api/interpreter
IRIS_OVERPASS_MIN_INTERVAL=2.0
IRIS_OVERPASS_CACHE=data/overpass_cache.sqlite
# Search radius (metres) around the geocoded point for candidate geometries.
IRIS_BUILDING_SEARCH_RADIUS_M=80
IRIS_PARKING_SEARCH_RADIUS_M=120
